@page "/sistemas"
@attribute [Authorize]
@using HealthCheck.Framework.Services.Database.MonitoredSystemService.Filters
@inject LoadingState loadingState
@implements IDisposable

<PageTitle>Sistemas Monitorados</PageTitle>

<div class="monitored-systems-page @(IsDarkMode ? "theme-dark" : "theme-light")">
    <MudPaper Class="page-hero pa-5 mb-4" Elevation="0">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Class="font-weight-bold">Sistemas monitorados</MudText>
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Visão geral de status e monitoramento em tempo real.</MudText>
        </MudStack>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddCircleOutline"
                   OnClick="() => OpenMonitoredSystemDialog()"
                   Disabled="loadingState.IsLoading">
            Novo sistema
        </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="search-panel pa-4 mb-4" Elevation="1">
        <MudStack Spacing="3">
            <MudStack Row="true" Class="search-row" Spacing="2" AlignItems="AlignItems.Center">
                <MudTextField @ref="textSearchRef"
                              T="string"
                              @oninput="OnInputSearch"
                              @onkeydown="OnKeyDownEnter"
                              Placeholder="Pesquisar por nome, URL ou descrição"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="search-input"
                              Disabled="loadingState.IsLoading" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="LoadMonitoredSystemsData"
                           Disabled="loadingState.IsLoading">
                    Pesquisar
                </MudButton>
            </MudStack>

            <MudDivider />

            @* <MudStack Spacing="1">
                <MudText Typo="Typo.subtitle2" Class="font-weight-medium">Filtros adicionais (em breve)</MudText>
                <MudPaper Class="future-filters pa-3" Elevation="0">
                    <MudStack Row="true" Spacing="1" Class="filter-chip-row">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Label="true" Disabled="true">Status</MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Label="true" Disabled="true">Intervalo</MudChip>
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Label="true" Disabled="true">Última checagem</MudChip>
                    </MudStack>
                </MudPaper>
            </MudStack> *@
        </MudStack>
    </MudPaper>

    @if (!loadingState.IsLoading && monitoredSystems.Count == 0)
    {
        <MudPaper Class="empty-state pa-8" Elevation="0">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Color="Color.Info" />
                <MudText Typo="Typo.h6">Nenhum sistema monitorado encontrado</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Registre o primeiro sistema para iniciar o monitoramento.</MudText>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var system in monitoredSystems)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <div class="system-card-shell" role="button" tabindex="0" @onclick="() => OpenMonitoredSystemDialog(system.Id)">
                        <MudPaper Class="@SystemCardClass" Elevation="2">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.h6" Class="font-weight-bold system-name" Title="@system.Name">@system.Name</MudText>
                                    <MudChip T="string" Label="true" Variant="Variant.Filled" Color="@GetStatusColor(system.LastStatus)">
                                        @system.LastStatus.GetDescription()
                                    </MudChip>
                                </MudStack>

                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="url-line">
                                    <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" Color="Color.Info" />
                                    <MudLink Href="@system.Url" Target="_blank" Typo="Typo.body2" Class="system-url" Title="@system.Url" @onclick:stopPropagation="true">@system.Url</MudLink>
                                </MudStack>

                                <MudDivider />

                                <MudGrid>
                                    <MudItem xs="12">
                                        <MudStack Spacing="0" AlignItems="AlignItems.Start">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Última checagem</MudText>
                                            <MudText Typo="Typo.body1">@FormatDateTime(system.LastCheckedAt)</MudText>
                                        </MudStack>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Criado em</MudText>
                                            <MudText Typo="Typo.body2">@FormatDateTime(system.CreatedAt)</MudText>
                                        </MudStack>
                                    </MudItem>
                                </MudGrid>
                            </MudStack>
                        </MudPaper>
                    </div>
                </MudItem>
            }
        </MudGrid>
    }
</div>

<SfDialog @ref="monitoredSystemDialog"
          Width="1240px"
          IsModal="true"
          ShowCloseIcon="true"
          Visible="false"
          CloseOnEscape="true"
          Target=".layout-root"
          CssClass="@DialogCssClass"
          ZIndex="1300"
          AllowDragging="false">
    <DialogTemplates>
        <Header>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudIcon Icon="@(selectedMonitoredSystemId == null ? Icons.Material.Filled.AddCircleOutline : Icons.Material.Filled.Edit)" Color="Color.Primary" />
                <MudText Typo="Typo.h6">@(editMonitoredSystem?.GetDialogTitle() ?? "")</MudText>
            </MudStack>
        </Header>

        <Content>
            <EditMonitoredSystem @ref="editMonitoredSystem"
                                 IsCreateMode="selectedMonitoredSystemId == null"
                                 MonitoredSystemId="selectedMonitoredSystemId"
                                 OnSaved="HandleDialogSaved"
                                 OnCloseRequested="CloseDialog" />
        </Content>
    </DialogTemplates>

    <DialogButtons>
        @if (selectedMonitoredSystemId != null)
        {
            <DialogButton Content="Excluir" IsPrimary="false" CssClass="e-danger delete-footer-button" Disabled="loadingState.IsLoading" OnClick="DeleteDialogData"></DialogButton>
        }
        <DialogButton Content="Cancelar" IsPrimary="false" CssClass="e-flat" Disabled="loadingState.IsLoading" OnClick="CloseDialog"></DialogButton>
        <DialogButton Content="@SaveButtonText" IsPrimary="true" CssClass="e-primary" Disabled="loadingState.IsLoading" OnClick="SaveDialogData"></DialogButton>
    </DialogButtons>

    <DialogPositionData X="center" Y="center" />

    <DialogEvents OnClose="CloseDialog" />
</SfDialog>

@code {

    [CascadingParameter(Name = "IsDarkMode")]
    public bool IsDarkMode { get; set; }

    [CascadingParameter(Name = "UserSession")]
    public UserSessionInfo? UserSession { get; set; }

    // Variáveis para o diálogo de criação/edição
    private Guid? selectedMonitoredSystemId;
    private SfDialog? monitoredSystemDialog;
    private EditMonitoredSystem? editMonitoredSystem;
    private MudTextField<string>? textSearchRef;
    private bool isClosingDialog;

    private string DialogCssClass => UserSession?.PreferredTheme == ThemeOptions.Dark ? "monitored-system-sync-dialog monitored-system-sync-dialog-dark" : "monitored-system-sync-dialog";
    private string SaveButtonText => selectedMonitoredSystemId == null ? "Registrar sistema" : "Salvar alterações";

    private string SystemCardClass => IsDarkMode ? "system-card system-card-dark pa-4" : "system-card system-card-light pa-4";


    private List<MonitoredSystem> monitoredSystems = [];
    SearchFiltersMonitoredSystems searchFiltersMonitoredSystems { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        loadingState.OnChange += HandleLoadingStateChanged;

        try
        {
            loadingState.Show("Carregando sistemas monitorados...");

            // ATRIBUO O UserId DA SESSÃO ATUAL AOS FILTROS DE PESQUISA
            searchFiltersMonitoredSystems.UserId = UserSession!.UserId;

            await LoadMonitoredSystemsData();
        }
        catch (Exception)
        {
            snackbar.Add("Ocorreu um erro ao carregar os sistemas monitorados", Severity.Error);
            throw;
        } 
        finally
        {
            loadingState.Hide();
        }
    }

    private void HandleLoadingStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    //***********************************************************************************************************
    //OBS: Necessário para evitar vazamento de memória devido à inscrição no evento do LoadingState
    //***********************************************************************************************************
    public void Dispose()
    {
        loadingState.OnChange -= HandleLoadingStateChanged;
    }

    private async Task LoadMonitoredSystemsData()
    {
        try
        {
            loadingState.Show("Carregando sistemas monitorados...");

            var result = await monitoredSystemService.GetAllMonitoredSystems(searchFiltersMonitoredSystems);

            if (result.IsFailure)
            {
                snackbar.Add(string.Join(", ", result.Failure?.Errors.Select(e => e.ErrorMessage) ?? ["Erro ao carregar os dados"]) , Severity.Error);
                return;
            }

            monitoredSystems = result.Success!.ToList();
        }   
        catch (Exception)
        {
            snackbar.Add("Ocorreu um erro ao carregar os sistemas monitorados", Severity.Error); 
            throw;
        }
        finally
        {
            loadingState.Hide();
        }
    }

    private void OpenMonitoredSystemDialog(Guid? monitoredSystemId = null)
    {
        selectedMonitoredSystemId = monitoredSystemId;
        monitoredSystemDialog!.ShowAsync();
    }

    private async Task SaveDialogData()
    {
        if (editMonitoredSystem is null)
            return;

        await editMonitoredSystem.SaveAsync();
    }

    private async Task DeleteDialogData()
    {
        if (editMonitoredSystem is null)
            return;

        await editMonitoredSystem.DeleteAsync();
    }

    private async Task CloseDialog()
    {
        if (isClosingDialog)
            return;

        isClosingDialog = true;
        selectedMonitoredSystemId = null;

        if (monitoredSystemDialog is not null)
        {
            await monitoredSystemDialog.HideAsync();
        }

        isClosingDialog = false;
    }

    private async Task HandleDialogSaved()
    {
        await LoadMonitoredSystemsData();
        await CloseDialog();
    }

    private async Task OnInputSearch(ChangeEventArgs args) =>
        searchFiltersMonitoredSystems.SearchTerm = args.Value?.ToString() ?? "";

    private async Task OnKeyDownEnter(KeyboardEventArgs args)
    {
        if(args.Key == "Enter")
        {
            await LoadMonitoredSystemsData();
            //NECESSÁRIO PARA GARANTIR QUE O FOCO VOLTE PARA O CAMPO DE PESQUISA APÓS PRESSIONA ENTER,
            //POIS O COMPONENTE DE LOADING FICA SOBREPOSTO E CHAMA O STATEHASCHANGED, O QUE CAUSA A PERDA DE FOCO DO CAMPO DE PESQUISA
            await textSearchRef!.FocusAsync();
        }
    }

    private static Color GetStatusColor(HealthStatus status)
        => status switch
        {
            HealthStatus.Healthy => Color.Success,
            HealthStatus.Unknown => Color.Warning,
            HealthStatus.Unhealthy => Color.Error,
            _ => Color.Default
        };

    private static string FormatDateTime(DateTime? value)
        => value == null || value <= DateTime.MinValue.AddDays(1) ? "Não informado" : value.Value.ToString("dd/MM/yyyy HH:mm");
}

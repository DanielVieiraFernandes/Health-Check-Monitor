@inject LoadingState loadingState
@inject IDialogService DialogService

<MudGrid Class="edit-monitored-system-grid" Spacing="3">
    <MudItem xs="12" lg="12" Class="dialog-column top-row-column">
        <MudPaper Class="register-card top-row-card pa-5" Elevation="0">
            <MudStack Spacing="8">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Dados do sistema</MudText>

                <MudTextField @bind-Value="monitoredSystem.Name"
                              @key="@($"name-{validationVersion}")"
                              Label="Nome do sistema"
                              Variant="Variant.Outlined"
                              Placeholder="Ex.: API de Faturamento"
                              MaxLength="255"
                              Counter="255"
                              Immediate="true"
                              Error="@HasError(nameof(MonitoredSystem.Name))"
                              ErrorText="@GetError(nameof(MonitoredSystem.Name))" />

                <MudTextField @bind-Value="monitoredSystem.Url"
                              @key="@($"url-{validationVersion}")"
                              Label="URL"
                              Variant="Variant.Outlined"
                              Placeholder="https://minha-api.com/health"
                              MaxLength="2048"
                              Counter="2048"
                              Immediate="true"
                              Error="@HasError(nameof(MonitoredSystem.Url))"
                              ErrorText="@GetError(nameof(MonitoredSystem.Url))" />

                <MudTextField @bind-Value="monitoredSystem.Description"
                              @key="@($"description-{validationVersion}")"
                              Label="Descrição do sistema"
                              Variant="Variant.Outlined"
                              Placeholder="Ex.: API responsável por processar faturamento e emissão de notas"
                              Lines="4"
                              MaxLength="1500"
                              Counter="1500"
                              Immediate="true"
                              Error="@HasError(nameof(MonitoredSystem.Description))"
                              ErrorText="@GetError(nameof(MonitoredSystem.Description))" />
            </MudStack>
        </MudPaper>
    </MudItem>


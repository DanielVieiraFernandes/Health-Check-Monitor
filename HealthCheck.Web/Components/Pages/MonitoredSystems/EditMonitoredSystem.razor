@inject LoadingState loadingState
@inject IDialogService DialogService

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Class="register-card pa-5" Elevation="0">
            <MudStack Spacing="3">
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Dados do sistema</MudText>

                <MudTextField @bind-Value="monitoredSystem.Name"
                              @key="@($"name-{validationVersion}")"
                              Label="Nome do sistema"
                              Variant="Variant.Outlined"
                              Placeholder="Ex.: API de Faturamento"
                              MaxLength="255"
                              Counter="255"
                              Immediate="true"
                              Error="@HasError(nameof(MonitoredSystem.Name))"
                              ErrorText="@GetError(nameof(MonitoredSystem.Name))" />

                <MudTextField @bind-Value="monitoredSystem.Url"
                              @key="@($"url-{validationVersion}")"
                              Label="URL"
                              Variant="Variant.Outlined"
                              Placeholder="https://minha-api.com/health"
                              MaxLength="2048"
                              Counter="2048"
                              Immediate="true"
                              Error="@HasError(nameof(MonitoredSystem.Url))"
                              ErrorText="@GetError(nameof(MonitoredSystem.Url))" />

                <MudNumericField T="int"
                                 @key="@($"interval-{validationVersion}")"
                                 @bind-Value="monitoredSystem.IntervalInMinutes"
                                 Label="Intervalo de verificação (minutos)"
                                 Variant="Variant.Outlined"
                                 Min="480"
                                 Max="1440"
                                 HideSpinButtons="false"
                                 Immediate="true"
                                 Error="@HasError(nameof(MonitoredSystem.IntervalInMinutes))"
                                 ErrorText="@GetError(nameof(MonitoredSystem.IntervalInMinutes))" />

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="hint-text">
                    Intervalo permitido pela regra atual: de 480 minutos (8 horas) até 1440 minutos (24 horas).
                </MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="4">
        <MudPaper Class="preview-card pa-4" Elevation="0">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Pré-visualização</MudText>
                <MudDivider />

                <MudText Typo="Typo.caption" Color="Color.Secondary">Nome</MudText>
                <MudText Typo="Typo.body1" Class="preview-name" Title="@GetPreviewName()">@GetPreviewName()</MudText>

                <MudText Typo="Typo.caption" Color="Color.Secondary">URL</MudText>
                <MudText Typo="Typo.body2" Class="preview-url" Title="@GetPreviewUrl()">@GetPreviewUrl()</MudText>

                @if (!IsCreateMode)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Criado em</MudText>
                    <MudText Typo="Typo.body2">@FormatDateTime(monitoredSystem.CreatedAt)</MudText>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {

    [CascadingParameter(Name = "UserSession")]
    public UserSessionInfo? UserSession { get; set; }

    [Parameter]
    public bool IsCreateMode { get; set; }

    [Parameter] 
    public Guid? MonitoredSystemId { get; set; }

    [Parameter] 
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnCloseRequested { get; set; }

    private readonly Dictionary<string, string> fieldErrors = [];

    private MonitoredSystem monitoredSystem { get; set; } = new();
    private MonitoredSystem originalMonitoredSystem { get; set; } = new();
    private int validationVersion;

    protected override async Task OnInitializedAsync()
    {
        ResetFieldErrors();

        // CASO ESTEJA EM MODO DE INCLUSÃO
        if (IsCreateMode)
        {
            InitializeDialogData();
            return;
        }

        // CASO O ID DO SISTEMA MONITORADO NÃO TENHA SIDO INFORMADO, 
        // FECHA O DIÁLOGO E EXIBE UMA MENSAGEM DE ERRO
        if (MonitoredSystemId is null || MonitoredSystemId == Guid.Empty)
        {
            snackbar.Add("Não foi possível identificar o sistema monitorado para edição.", Severity.Error); 
            await RequestClose();
            return;
        }

        await LoadMonitoredSystemData(MonitoredSystemId.Value);
    }

    public string GetDialogTitle()
        => IsCreateMode ? "Registrar sistema monitorado" : "Editar sistema monitorado";

    private void InitializeDialogData()
    {
        monitoredSystem = new();
        originalMonitoredSystem = monitoredSystem.Clone();
    }

    private async Task OnDeleteClick(object _)
    {
        if (IsCreateMode || loadingState.IsLoading)
            return;

        var idToDelete = monitoredSystem.Id != Guid.Empty ? monitoredSystem.Id : MonitoredSystemId;

        if (idToDelete is null || idToDelete == Guid.Empty)
        {
            snackbar.Add("Não foi possível identificar o sistema monitorado para exclusão.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            [nameof(ConfirmDeleteMonitoredSystemDialog.Name)] = monitoredSystem.Name,
            [nameof(ConfirmDeleteMonitoredSystemDialog.Url)] = monitoredSystem.Url,
            [nameof(ConfirmDeleteMonitoredSystemDialog.CreatedAt)] = monitoredSystem.CreatedAt
        };

        var options = new MudBlazor.DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteMonitoredSystemDialog>("Confirmar exclusão", parameters, options);
        var result = await dialog.Result;

        if (result!.Canceled)
            return;

        await DeleteData(idToDelete.Value);
    }

    private async Task SaveData()
    {
        try
        {
            loadingState.Show(IsCreateMode ? "Registrando sistema monitorado..." : "Salvando alterações do sistema monitorado...");

            if (IsCreateMode)
            {
                monitoredSystem.UserId = UserSession!.UserId;

                var result = await monitoredSystemService.CreateMonitoredSystem(monitoredSystem);

                if (result.IsFailure)
                {
                    //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                    // Caso tenha ocorrido um erro de validação, exibir mensagens específicas para cada campo
                    //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
                    if(result.Failure!.StatusCode == System.Net.HttpStatusCode.BadRequest)
                    {
                        ApplyFieldErrors(result.Failure); 
                    }

                    await ShowFailureDialog("Falha ao registrar sistema", result.Failure);
                    return;
                }

                snackbar.Add("Sistema monitorado registrado com sucesso.", Severity.Success);
            }
            else
            {
                var result = await monitoredSystemService.UpdateMonitoredSystem(monitoredSystem, originalMonitoredSystem, changeBy: UserSession!.UserName);

                if (result.IsFailure)
                {
                    if(result.Failure!.StatusCode == System.Net.HttpStatusCode.BadRequest)
                    {
                        ApplyFieldErrors(result.Failure);
                    }

                    await ShowFailureDialog("Falha ao atualizar sistema", result.Failure);
                    return;
                }

                snackbar.Add("Sistema monitorado atualizado com sucesso.", Severity.Success);
            }   

            await OnSaved.InvokeAsync();
        }
        catch (Exception)
        {
            snackbar.Add("Não foi possível salvar os dados do sistema monitorado.", Severity.Error);
            throw;
        }
        finally
        {
            loadingState.Hide();
        }
    }

    private async Task LoadMonitoredSystemData(Guid monitoredSystemId)
    {
        try
        {
            loadingState.Show("Carregando dados do sistema...");

            var result = await monitoredSystemService.GetMonitoredSystemById(monitoredSystemId);

            if (result.IsFailure)
            {
                await ShowFailureDialog("Falha ao buscar dados do sistema monitorado", result.Failure);
                return;
            }

            monitoredSystem = result.Success!;
            originalMonitoredSystem = result.Success!.Clone();
        }
        catch (Exception)
        {
            snackbar.Add("Não foi possível carregar os dados do sistema monitorado.", Severity.Error);
            //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
            // Lançar a exceção para que o CustomErrorBoundary possa capturá-la e registrar o log detalhado do erro
            //+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
            throw;
        }
        finally
        {
            loadingState.Hide();
        }
    }

    private async Task ShowFailureDialog(string title, Failure? failure)
    {
        var parameters = new DialogParameters
        {
            [nameof(ErrorReportDialog.Title)] = title,
            [nameof(ErrorReportDialog.Errors)] = failure?.Errors.Select(error => error.ErrorMessage).ToList() ?? []
        };

        var options = new MudBlazor.DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = false
        };

        await DialogService.ShowAsync<ErrorReportDialog>("", parameters, options);
    }

    private async Task DeleteData(Guid idToDelete)
    {
        try
        {
            loadingState.Show("Excluindo sistema monitorado...");

            var result = await monitoredSystemService.DeleteMonitoredSystem(idToDelete, UserSession!.UserId);

            if (result.IsFailure)
            {
                await ShowFailureDialog("Falha ao excluir sistema", result.Failure);
                return;
            }

            snackbar.Add("Sistema monitorado excluído com sucesso.", Severity.Success);
            await OnSaved.InvokeAsync();
        }
        catch (Exception)
        {
            snackbar.Add("Não foi possível excluir o sistema monitorado.", Severity.Error);
            throw;
        }
        finally
        {
            loadingState.Hide();
        }
    }

    public Task SaveAsync()
        => SaveData();

    public Task DeleteAsync()
        => OnDeleteClick(default!);

    private async Task RequestClose()
        => await OnCloseRequested.InvokeAsync();

    private bool HasError(string fieldName) => fieldErrors.ContainsKey(fieldName);

    private string? GetError(string fieldName)
        => fieldErrors.TryGetValue(fieldName, out var error) ? error : null;

    private string GetPreviewName()
        => string.IsNullOrWhiteSpace(monitoredSystem.Name) ? "Nome do sistema" : monitoredSystem.Name;

    private string GetPreviewUrl()
        => string.IsNullOrWhiteSpace(monitoredSystem.Url) ? "https://seu-endpoint.com/health" : monitoredSystem.Url;

    private static string FormatDateTime(DateTime value)
        => value <= DateTime.MinValue.AddDays(1) ? "Não informado" : value.ToString("dd/MM/yyyy HH:mm");

    private void ResetFieldErrors()
    {
        fieldErrors.Clear();
        validationVersion++;
    }

    private void ApplyFieldErrors(Failure? failure)
    {
        if (failure is null)
            return;

        var groupedErrors = failure.Errors
            .Where(error => !string.IsNullOrWhiteSpace(error.PropertyName))
            .GroupBy(error => NormalizePropertyName(error.PropertyName))
            .ToDictionary(
                group => group.Key,
                group => string.Join(" - ", group.Select(item => item.ErrorMessage).Distinct())
            );

        foreach (var kvp in groupedErrors)
            fieldErrors[kvp.Key] = kvp.Value;

        validationVersion++;
    }

    private static string NormalizePropertyName(string propertyName)
        => propertyName.Contains('.') ? propertyName.Split('.').Last() : propertyName;

}

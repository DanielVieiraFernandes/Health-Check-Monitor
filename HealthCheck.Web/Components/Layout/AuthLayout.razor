@inherits LayoutComponentBase
@implements IDisposable
@inject IJSRuntime JS
@inject LoadingState loadingState

<MudThemeProvider @bind-IsDarkMode="@isDarkMode" Theme="@meuTemaCustomizado" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<div class="auth-layout-root @(isDarkMode ? "theme-dark" : "theme-light")">
    <MudMainContent Class="auth-main-content">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="auth-content-wrapper">
            @Body
        </MudContainer>
    </MudMainContent>
</div>

@if (loadingState.IsLoading)
{
    <div class="global-loading-overlay">
        <LoadingSpinner Text="@loadingState.Message" SpinnerSize="Size.Large" />
    </div>
}

@code {
    private bool isDarkMode = true;

    private MudTheme meuTemaCustomizado = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#2563EB",
            Secondary = "#64748B",
            Info = "#0EA5A0",
            Success = "#16A34A",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F6F8FB",
            Surface = "#FFFFFF",
            AppbarBackground = "#0F172A",
            DrawerBackground = "#F8FAFC",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            Divider = "#E2E8F0"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#60A5FA",
            Secondary = "#94A3B8",
            Info = "#22D3EE",
            Success = "#4ADE80",
            Warning = "#FBBF24",
            Error = "#F87171",
            Background = "#0B1120",
            Surface = "#0F172A",
            AppbarBackground = "#0B1120",
            DrawerBackground = "#0F172A",
            TextPrimary = "#E2E8F0",
            TextSecondary = "#94A3B8",
            Divider = "#1E293B"
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Inter", "Segoe UI", "Arial", "sans-serif" }
            }
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("toggleTheme", isDarkMode ? "fluent2-dark" : "fluent2");
        }
    }

    protected override void OnInitialized()
    {
        //==============================================================================================
        // Mantém o loading global sincronizado durante a tela de login.
        //==============================================================================================
        loadingState.OnChange += HandleLoadingStateChanged;
    }

    public void Dispose()
    {
        loadingState.OnChange -= HandleLoadingStateChanged;
    }

    private void HandleLoadingStateChanged()
    {
        //------------------------------------------------------------------------------------------
        // Re-renderiza o layout quando o LoadingState é atualizado.
        //------------------------------------------------------------------------------------------
        InvokeAsync(StateHasChanged);
    }
}
